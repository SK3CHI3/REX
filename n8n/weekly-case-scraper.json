      "id": "5184c33e-8b57-412a-addf-cf2b09bcaf38",
      "name": "Case Extraction Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2100,
        620
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"isRelevant\": {\n      \"type\": \"boolean\",\n      \"description\": \"true only if the article describes a specific Kenyan police brutality/misconduct incident\"\n    },\n    \"title\": {\n      \"type\": \"string\"\n    },\n    \"description\": {\n      \"type\": \"string\"\n    },\n    \"location\": {\n      \"type\": \"string\"\n    },\n    \"county\": {\n      \"type\": \"string\"\n    },\n    \"incidentDate\": {\n      \"type\": \"string\",\n      \"description\": \"ISO 8601 date if known, else empty string\"\n    },\n    \"victimName\": {\n      \"type\": \"string\"\n    },\n    \"severity\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\",\n        \"critical\"\n      ]\n    },\n    \"tags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"isRelevant\",\n    \"title\",\n    \"description\"\n  ]\n}"
      }
    },
    {
      "id": "e418764f-5746-4ae7-a611-1ddbc1a596bc",
      "name": "AI Agent - Extract Case",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        2360,
        260
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Article title: {{ $json.title }}\nSource URL: {{ $json.url }}\nPublished: {{ $json.publishedDate }}\n\nArticle text:\n{{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a careful human-rights research assistant reviewing Kenyan news articles for the REX police brutality tracker. Read the article text and decide if it describes a specific incident of police brutality, misconduct, unlawful killing, or excessive force in Kenya. If it is general commentary, unrelated news, or a duplicate/roundup with no new specific incident, set isRelevant to false and leave other fields empty. If relevant, extract the fields factually from the article only - never invent details that are not in the text. Write description as 2-4 neutral, factual sentences."
        }
      }
    },
