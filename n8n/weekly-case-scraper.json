    {
      "id": "7fccf42e-5955-4a91-a717-4f1ebefe7866",
      "name": "Build Apify Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        -120
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $json;\nconst cfg = $('Set Run Config').item.json;\nconst urls = (Array.isArray(source.category_urls) && source.category_urls.length)\n  ? source.category_urls\n  : [source.base_url];\n\nconst pageFunction = `async function pageFunction(context) {\n    const { $, request } = context;\n    const url = request.url;\n    const title = $('h1').first().text().trim() || $('title').text().trim();\n    const paragraphs = [];\n    $('article p, main p, .article-body p, .entry-content p, .post-content p').each((i, el) => {\n        const t = $(el).text().trim();\n        if (t) paragraphs.push(t);\n    });\n    const text = paragraphs.join('\\\\n\\\\n');\n    if (!text || text.length < 200) {\n        return null;\n    }\n    const publishedDate = $('meta[property=\"article:published_time\"]').attr('content')\n        || $('time').attr('datetime')\n        || null;\n    return { url, title, text, publishedDate };\n}`;\n\nreturn { json: {\n  apifyBody: {\n    startUrls: urls.map(u => ({ url: u })),\n    linkSelector: 'a',\n    maxCrawlingDepth: 1,\n    maxPagesPerCrawl: cfg.maxPagesPerSource,\n    pageFunction,\n  }\n}};"
      }
    },
    {
      "id": "361de7a2-f9c0-4b4a-9c2b-8d2df03fb841",
      "name": "Run Apify Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1840,
        -120
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apify~cheerio-scraper/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $env.APIFY_API_TOKEN }}"
            },
            {
              "name": "memory",
              "value": "256"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.apifyBody }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "fddcc4e1-00f3-4f3a-baf4-55d05ba10278",
      "name": "Filter & Track New URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        -120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const source = $('Loop Over Sources').item.json;\nconst staticData = $getWorkflowStaticData('global');\nconst seen = new Set(staticData.scrapedUrls || []);\nconst maxNewPerSource = $('Set Run Config').item.json.maxNewPerSource;\n\nlet articles = [];\nfor (const item of $input.all()) {\n  const data = item.json;\n  if (Array.isArray(data)) articles.push(...data);\n  else if (Array.isArray(data.data)) articles.push(...data.data);\n  else if (data && data.url) articles.push(data);\n}\n\nlet newCount = 0;\nconst foundCount = articles.length;\nfor (const art of articles) {\n  if (!art || !art.url) continue;\n  if (seen.has(art.url)) continue;\n  if (newCount >= maxNewPerSource) break;\n  seen.add(art.url);\n  staticData.newArticles.push({\n    sourceId: source.id,\n    sourceName: source.name,\n    url: art.url,\n    title: art.title || '',\n    text: art.text || art.content || '',\n    publishedDate: art.publishedDate || null,\n  });\n  newCount++;\n}\nstaticData.scrapedUrls = Array.from(seen);\nstaticData.jobStats[source.id] = {\n  sourceId: source.id,\n  sourceName: source.name,\n  articlesFound: foundCount,\n  newArticles: newCount,\n  errors: 0,\n};\n\nreturn [{ json: { source: source.name, found: foundCount, new: newCount } }];"
      }
    },
    {
      "id": "9f5ede39-2f0b-4c33-9266-d771b5741aff",
      "name": "Load Aggregated New Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst maxTotal = $('Set Run Config').item.json.maxNewTotal;\nconst articles = (staticData.newArticles || []).slice(0, maxTotal);\nif (articles.length === 0) return [];\nreturn articles.map(a => ({ json: a }));"
      }
    },
