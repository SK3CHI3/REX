      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.scrapedUrls = $input.all().map(item => item.json.url).filter(Boolean);\nstaticData.newArticles = [];\nstaticData.jobStats = {};\nreturn [{ json: { cachedUrlCount: staticData.scrapedUrls.length } }];"
      }
    },
